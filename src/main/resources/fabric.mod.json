{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "File archives stored in Minecraft books and Litematica schematics.",
  "authors": [
    "awszqsedxzaw"
  ],
  "contact": {
    "sources": "https://github.com/awszqsedxzaw/CloudArchive",
    "issues": "https://github.com/awszqsedxzaw/CloudArchive/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "awszqsedxzaw.cloudarchive.CloudArchiveMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": ">=${fabric_api_version}"
  }
}
